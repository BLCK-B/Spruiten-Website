---
import { Icon } from "astro-icon/components";

export interface Props {
	appName: string;
	pageLink: string;
	appLink: string;
}

const { appName, pageLink, appLink } = Astro.props;
---

<div class="flex flex-row justify-between">
	<h3 class="text-xl font-semibold text-gray-900 mb-2">{appName}</h3>
	<div class="flex gap-3">
		<a
			href={pageLink} title="App info"
			class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center mb-4"
		>
			<Icon
				name="tabler:eye"
				class="w-6 h-6 text-gray-900"
				aria-hidden="true"
			/>
		</a>
		<a
			href={appLink} title="Open app"
			class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center mb-4"
		>
			<Icon
				name="tabler:login-2"
				class="w-6 h-6 text-gray-900"
				aria-hidden="true"
			/>
		</a>
	</div>
</div>
