---
import { Icon } from "astro-icon/components";
---

<footer
  id="contact"
  class="w-full py-12 px-4 border-t border-gray-200 bg-white"
  role="contentinfo"
>
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <div>
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Legal</h2>
        <ul class="space-y-2">
          <li>
            <a
              href="/src/components/AppList"
              class="text-gray-600 hover:text-gray-900 transition-colors"
              >Privacy policy</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Contact</h2>
        <ul class="space-y-2">
          <li>
            <a
              href="https://github.com/blck-b"
              class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Visit our GitHub (opens in new tab)"
            >
              <Icon name="tabler:brand-github" class="w-5 h-5" aria-hidden="true" />
              <span>GitHub</span></a
            >
          </li>
          <!--<li>-->
          <!--  <a-->
          <!--    href="/contact"-->
          <!--    class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"-->
          <!--  >-->
          <!--    <Icon name="tabler:mail" class="w-5 h-5" aria-hidden="true" />-->
          <!--    <span>Email</span></a-->
          <!--  >-->
          <!--</li>-->
        </ul>
      </div>
    </div>
  </div>
</footer>
