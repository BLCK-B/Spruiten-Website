---
import AppCardHeader from "./AppCardHeader.astro";

const cardClass = "p-5 bg-white rounded-lg border border-gray-200 sm:max-w-xl sm:mx-auto lg:max-w-none lg:mx-0";
const cardBodyClass = "flex flex-col sm:flex-row sm:justify-between gap-6 mt-2";
---

<section id="features" class="max-w-6xl mx-auto px-4 pb-15" >
	<div class="grid lg:grid-cols-2 gap-8">

		<div class={cardClass}>
			<AppCardHeader appName="Planner" pageLink="/planner" appLink="https://planner.spruits.eu" />
			<div class={cardBodyClass}>
				<div class="flex-1">
					<p class="text-gray-600">
						Planner is the most intuitive everyday to-do list. Keep track of all events and work with minimal overhead.
					</p>
				</div>
				<img src="/planner_app_preview.png" class="app-img w-60" alt="App preview image" />
			</div>
		</div>

		<div class={cardClass}>
			<AppCardHeader appName="Mattermaps" appLink="https://maps.spruits.eu"/>
			<div class={cardBodyClass}>
				<div class="flex-1">
					<p class="text-gray-600">
						3D maps with accurate elevation data and powerful route planning (OSM, GraphHopper, Mapterhorn).
					</p>
				</div>
				<img src="/maps_app_preview.png" class="app-img w-57 border border-gray-100" alt="App preview image" />
			</div>
		</div>

		<div class={cardClass}>
			<AppCardHeader appName="Simple Tools" appLink="https://simpletools.spruits.eu"/>
			<div class={cardBodyClass}>
				<div class="flex-1">
					<p class="text-gray-600">
						Browser utilities like diff check, JSON formatter, find and replace. All data stays local.
					</p>
				</div>
				<img src="/simpletools_app_preview.png" class="app-img w-57 border border-gray-100" alt="App preview image" />
			</div>
		</div>

	</div>
</section>

<style lang="scss">
	.app-img {
		border-radius: 2px;
		display: block;
		margin: 0 auto;
	}
</style>
