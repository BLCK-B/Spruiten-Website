---
import AppCardHeader from "./AppCardHeader.astro";
---

<section id="features" class="max-w-6xl mx-auto px-4 pb-15" >
	<div class="grid md:grid-cols-2 gap-8">
		<div
			class="p-6 bg-white rounded-lg border border-gray-200"
		>
			<AppCardHeader appName="Planner" pageLink="/planner" appLink="https://planner.spruits.eu"/>
			<p class="text-gray-600">
				Planner app
			</p>
		</div>
		<div
			class="p-6 bg-white rounded-lg border border-gray-200"
		>
			<AppCardHeader appName="Simple Tools" pageLink="/simpletools" appLink="https://simpletools.spruits.eu"/>
			<p class="text-gray-600">
				Utilities
			</p>
		</div>
	</div>
</section>
